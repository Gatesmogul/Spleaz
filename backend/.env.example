NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=*
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/spleaz_db?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
GOOGLE_MAPS_API_KEY=your-google-maps-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@example.com
FROM_NAME=Spleaz
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
ADMIN_PASSWORD_SETUP_URL=https://spleaz.onrender.com/admin/set-password

SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Spleaz Administration <your-email>
